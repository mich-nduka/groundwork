{
  "name": "Groundwork",
  "description": "A lean starting point for new software projects: no language, framework or hosting chosen for you, and no document written before there is something to put in it. Profiles adapt the documents and checks to the kind of system you build.",
  "version": "4.0.0",
  "technology_agnostic": true,
  "principle": "progressive documentation",
  "files": [
    ".gitignore",
    ".groundwork/README.md",
    ".groundwork/blueprints/adr.md",
    ".groundwork/blueprints/feature-spec.md",
    ".groundwork/blueprints/plan.md",
    ".groundwork/examples/EXAMPLE.md",
    ".groundwork/examples/PROFILES.md",
    ".groundwork/manifest.json",
    ".groundwork/profiles/README.md",
    ".groundwork/profiles/ai-systems/README.md",
    ".groundwork/profiles/ai-systems/onboarding.json",
    ".groundwork/profiles/ai-systems/profile.json",
    ".groundwork/profiles/ai-systems/templates/docs/ai-systems/EVALUATION.md",
    ".groundwork/profiles/ai-systems/templates/docs/ai-systems/MODEL_INTEGRATION.md",
    ".groundwork/profiles/ai-systems/templates/docs/ai-systems/RETRIEVAL.md",
    ".groundwork/profiles/ai-systems/templates/docs/ai-systems/SAFETY.md",
    ".groundwork/profiles/application/README.md",
    ".groundwork/profiles/application/onboarding.json",
    ".groundwork/profiles/application/profile.json",
    ".groundwork/profiles/application/templates/docs/application/RELEASES.md",
    ".groundwork/profiles/backend-api/README.md",
    ".groundwork/profiles/backend-api/onboarding.json",
    ".groundwork/profiles/backend-api/profile.json",
    ".groundwork/profiles/backend-api/templates/docs/backend-api/DATA.md",
    ".groundwork/profiles/content-site/README.md",
    ".groundwork/profiles/content-site/onboarding.json",
    ".groundwork/profiles/content-site/profile.json",
    ".groundwork/profiles/content-site/templates/docs/content-site/CONTENT.md",
    ".groundwork/profiles/content-site/templates/docs/content-site/SEO.md",
    ".groundwork/profiles/core/onboarding.json",
    ".groundwork/profiles/core/profile.json",
    ".groundwork/profiles/core/templates/.github/pull_request_template.md",
    ".groundwork/profiles/core/templates/.github/workflows/docs-check.yml",
    ".groundwork/profiles/core/templates/BUILD.md",
    ".groundwork/profiles/core/templates/docs/architecture/REPOSITORY_STRUCTURE.md",
    ".groundwork/profiles/core/templates/docs/architecture/SYSTEM_DESIGN.md",
    ".groundwork/profiles/core/templates/docs/architecture/contracts/README.md",
    ".groundwork/profiles/core/templates/docs/design/DESIGN.md",
    ".groundwork/profiles/core/templates/docs/engineering/SECURITY.md",
    ".groundwork/profiles/core/templates/docs/engineering/TEST_STRATEGY.md",
    ".groundwork/profiles/core/templates/docs/product/PRD.md",
    ".groundwork/profiles/core/templates/docs/product/SPEC.md",
    ".groundwork/scripts/checks.mjs",
    ".groundwork/scripts/groundwork.mjs",
    ".groundwork/scripts/onboarding.mjs",
    "AGENTS.md",
    "GROUNDWORK.md",
    "PROJECT.md",
    "README.md"
  ],
  "notes": [
    "A project starts with the files outside .groundwork/ in this list; .groundwork/ holds Groundwork's scripts, profiles, templates and blueprints.",
    "Every other document is created from its template (groundwork add PATH) once there is something to write in it. Profiles are chosen after discovery (groundwork init).",
    "Every document has one owner: core, or the one profile with a template for it."
  ]
}
